# Coordinator service settings. Copy to .env for local runs; in Dokploy, set
# them as the application's environment. Never commit real values.

# Where people reach the service. https outside localhost; cookies are Secure on https.
BASE_URL=http://localhost:3000
PORT=3000
# 1 when behind a reverse proxy (Dokploy's Traefik) that sets X-Forwarded-For.
# Rate limits and the webhook's 5 MB in-flight cap go per client address: without
# this behind a proxy, every client shares the proxy's address and one cap.
TRUST_PROXY=0

# Postgres. Unset: an in-memory store (fine for a quick look; gone on restart).
DATABASE_URL=postgres://coordinator:coordinator-dev@localhost:5452/coordinator

# At least 32 random characters: openssl rand -base64 48
# Derives the key that encrypts people's GitHub tokens at rest and the CSRF key.
SESSION_SECRET=

# From the GitHub App (see README: "Register the GitHub App").
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The App's private key: the PEM on one line with \n escapes, or a mounted file.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem

# Optional
# STATE_BRANCH=coordinator-state
# RESYNC_MINUTES=15         every installation is re-read this often, so a missed webhook heals
# ACCESS_TTL_SECONDS=60      how long a "may read this repo" answer is reused, per person (max 60)
# SESSION_DAYS=7
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com

# Reading runs fairly between installations (c14). All optional.
# PARSE_WORKERS=2             worker threads that read logs; a large log never takes the last one (1-32)
# PARSE_SMALL_KB=512          a file up to this size is "small" and may use any worker (1-16384)
# PARSE_BUDGET_SECONDS=600    reading time each installation gets per hour; past it, its logs wait for the next resync (1-3600)
# SYNC_MAX_MB=64              log bytes one sync of one repo reads; the rest follow at the next sync (8-4096)

# Alerts (design 9) and the doorbell. All optional: without SMTP there is no
# email, without the VAPID keys no web push; GitHub mentions and the rest still work.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587               465 with SMTP_SECURE=1
# SMTP_SECURE=0               1: TLS from the start (port 465); 0: STARTTLS when offered
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Coordinator <coordinator@example.com>
# Web push keys: npx web-push generate-vapid-keys (set both, or neither)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# ALERT_SWEEP_SECONDS=60      how often quiet leads are looked for and due digests sent (10-3600)
# DOORBELL_MAX_STREAMS=500    open doorbell streams at most (0: the doorbell is off; watch --remote polls)
