# Coordinator service settings. Copy to .env for local runs; in Dokploy, set
# them as the application's environment. Never commit real values.

# Where people reach the service. https outside localhost; cookies are Secure on https.
BASE_URL=http://localhost:3000
PORT=3000
# 1 when behind a reverse proxy (Dokploy's Traefik) that sets X-Forwarded-For.
TRUST_PROXY=0

# Postgres. Unset: an in-memory store (fine for a quick look; gone on restart).
DATABASE_URL=postgres://coordinator:coordinator-dev@localhost:5452/coordinator

# At least 32 random characters: openssl rand -base64 48
# Derives the key that encrypts people's GitHub tokens at rest and the CSRF key.
SESSION_SECRET=

# From the GitHub App (see README: "Register the GitHub App").
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The App's private key: the PEM on one line with \n escapes, or a mounted file.
GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem

# Optional
# STATE_BRANCH=coordinator-state
# ACCESS_TTL_SECONDS=60      how long a "may read this repo" answer is reused, per person (max 300)
# SESSION_DAYS=7
# GITHUB_API_URL=https://api.github.com
# GITHUB_WEB_URL=https://github.com
